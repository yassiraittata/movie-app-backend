generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "esm"
}

datasource db {
    provider = "postgresql"
}

model User {
    id        String   @id @default(uuid()) @db.Uuid
    name      String?
    email     String   @unique
    createdAt DateTime @default(now())
}
